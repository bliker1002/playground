//
//  DragonflyDriver.iig
//  USB DriverKit extension that claims the Dragonfly spectrometer (VID 0x0451, PID 0x4200)
//  and exposes raw 64-byte report I/O to the DragonflyScope app.
//
//  iPadOS has no API for apps to talk to vendor-specific HID devices, so this driver matches at
//  the USB *device* level (before the system HID driver can claim the interface) and does the
//  interrupt-endpoint transfers itself.
//

#ifndef DragonflyDriver_h
#define DragonflyDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>

class IOUserClient;

class DragonflyDriver: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient ** userClient) override;

    // Called by DragonflyUserClient.
    kern_return_t WriteReport(const uint8_t * data, uint32_t length) LOCALONLY;
    kern_return_t ReadReport(uint8_t * data, uint32_t * length, uint32_t timeoutMs) LOCALONLY;
};

#endif /* DragonflyDriver_h */
